SERVER_URL=localhost:3000
DATABASE_URL=postgres://postgres:mysecretpassword@localhost:5432/machineslabs
PAYLOAD_SECRET=<your-payload-secret> # open ssl rand -hex 32

# Cloudflare R2 (S3-compatible) — media storage.
# Disabled in dev by default (uploads go to local ./media). Set USE_R2=true to
# use R2 locally; in production (NODE_ENV=production) R2 is always used.
# USE_R2=true
S3_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
S3_BUCKET=<your-bucket-name>
S3_ACCESS_KEY_ID=<your-access-key-id>
S3_SECRET_ACCESS_KEY=<your-secret-access-key>

BETTER_AUTH_SECRET=<your-better-auth-secret>
BETTER_AUTH_URL=http://localhost:3000

# Better Auth Registration control
DISABLE_SIGNUP=false

